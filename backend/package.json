{
  "name": "fork-flame-backend",
  "version": "1.0.0",
  "description": "Backend API for Fork & Flame restaurant website",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "predev": "mongosh --quiet --eval 1 >/dev/null 2>&1 || npm run db",
    "dev": "nodemon --watch src --watch .env src/server.js",
    "prestart": "mongosh --quiet --eval 1 >/dev/null 2>&1 || npm run db",
    "test": "node tests/api.test.mjs",
    "seed": "node src/seed.js",
    "seed-menus": "node src/seedMenus.js",
    "create-admin": "node src/createAdmin.js",
    "db": "mkdir -p ~/mongodb-data && mongod --dbpath ~/mongodb-data --bind_ip 127.0.0.1 --fork --logpath ~/mongodb-data/mongod.log"
  },
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4",
    "razorpay": "^2.9.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
