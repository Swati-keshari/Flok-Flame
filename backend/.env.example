PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/fork-flame
CLIENT_URL=http://localhost:5173
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me

# Razorpay (Dashboard -> Account & Settings -> API Keys). Leave empty to allow only Cash on Delivery
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Email (optional). Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it below (16 letters, no spaces).
# Leave empty and emails are only printed in the terminal.
SMTP_USER=
SMTP_PASS=
